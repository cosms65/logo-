generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EDITOR
  ADMIN
}

enum PublishStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum EntityType {
  ARTICLE
  CHARACTER
  FACTION
  CHAPTER
  TIMELINE_EVENT
  CATEGORY
  MEDIA_ASSET
  LOCATION
  REALM
}

enum RelationshipType {
  RELATED
  MEMBER_OF
  LEADS
  ALLY
  RIVAL
  APPEARS_IN
  REFERENCES
  PARENT_OF
  CUSTOM
}

model User {
  id              String            @id @default(cuid())
  name            String?
  email           String            @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  role            Role              @default(USER)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  accounts        Account[]
  sessions        Session[]
  articles        Article[]         @relation("ArticleAuthor")
  chapters        Chapter[]         @relation("ChapterAuthor")
  mediaAssets     MediaAsset[]
  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  articles    Article[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId])
}

model Article {
  id             String          @id @default(cuid())
  title          String
  slug           String          @unique
  excerpt        String?
  content        Json            @default("{}")
  renderedText   String          @default("")
  status         PublishStatus   @default(DRAFT)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  authorId       String?
  author         User?           @relation("ArticleAuthor", fields: [authorId], references: [id])
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id])
  tags           Tag[]           @relation("ArticleTags")
  customFields   CustomField[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([title])
}

model Character {
  id              String        @id @default(cuid())
  name            String
  slug            String        @unique
  bannerImageId   String?
  portraitImageId String?
  biography       Json          @default("{}")
  renderedText    String        @default("")
  status          String?
  bannerImage     MediaAsset?   @relation("CharacterBanner", fields: [bannerImageId], references: [id])
  portraitImage   MediaAsset?   @relation("CharacterPortrait", fields: [portraitImageId], references: [id])
  customFields    CustomField[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([name])
}

model Faction {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  description   Json          @default("{}")
  renderedText  String        @default("")
  bannerId      String?
  logoId        String?
  banner        MediaAsset?   @relation("FactionBanner", fields: [bannerId], references: [id])
  logo          MediaAsset?   @relation("FactionLogo", fields: [logoId], references: [id])
  customFields  CustomField[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([name])
}

model Volume {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?
  position    Int       @default(0)
  chapters    Chapter[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Chapter {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  number          Int
  content         Json              @default("{}")
  renderedText    String            @default("")
  status          PublishStatus     @default(DRAFT)
  publishedAt     DateTime?
  scheduledFor    DateTime?
  volumeId        String?
  volume          Volume?           @relation(fields: [volumeId], references: [id])
  authorId        String?
  author          User?             @relation("ChapterAuthor", fields: [authorId], references: [id])
  readingProgress ReadingProgress[]
  bookmarks       Bookmark[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([volumeId, number])
  @@index([status, publishedAt])
}

model ReadingProgress {
  id        String   @id @default(cuid())
  userId    String
  chapterId String
  progress  Float    @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  chapterId String
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
}

model MediaAsset {
  id                    String      @id @default(cuid())
  publicId              String      @unique
  url                   String
  secureUrl             String
  format                String?
  width                 Int?
  height                Int?
  altText               String?
  usage                 String?
  uploadedById          String?
  uploadedBy            User?       @relation(fields: [uploadedById], references: [id])
  characterBanners      Character[] @relation("CharacterBanner")
  characterPortraits    Character[] @relation("CharacterPortrait")
  factionBanners        Faction[]   @relation("FactionBanner")
  factionLogos          Faction[]   @relation("FactionLogo")
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([usage])
}

model TimelineEvent {
  id           String      @id @default(cuid())
  title        String
  slug         String      @unique
  description  Json        @default("{}")
  renderedText String      @default("")
  era          String?
  startsAt     DateTime?
  endsAt       DateTime?
  sortOrder    Int         @default(0)
  tags         Tag[]       @relation("TimelineTags")
  customFields CustomField[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([startsAt, sortOrder])
}

model Tag {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  articles       Article[]       @relation("ArticleTags")
  timelineEvents TimelineEvent[] @relation("TimelineTags")
}

model CustomFieldDefinition {
  id         String     @id @default(cuid())
  entityType EntityType
  key        String
  label      String
  fieldType  String     @default("text")
  required   Boolean    @default(false)
  sortOrder  Int        @default(0)
  fields     CustomField[]

  @@unique([entityType, key])
}

model CustomField {
  id           String                 @id @default(cuid())
  definitionId String
  value        Json
  articleId    String?
  characterId  String?
  factionId    String?
  timelineId   String?
  definition   CustomFieldDefinition  @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  article      Article?               @relation(fields: [articleId], references: [id], onDelete: Cascade)
  character    Character?             @relation(fields: [characterId], references: [id], onDelete: Cascade)
  faction      Faction?               @relation(fields: [factionId], references: [id], onDelete: Cascade)
  timeline     TimelineEvent?         @relation(fields: [timelineId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([characterId])
  @@index([factionId])
  @@index([timelineId])
}

model Relationship {
  id             String           @id @default(cuid())
  sourceType     EntityType
  sourceId       String
  targetType     EntityType
  targetId       String
  type           RelationshipType @default(RELATED)
  label          String?
  metadata       Json             @default("{}")
  createdAt      DateTime         @default(now())

  @@unique([sourceType, sourceId, targetType, targetId, type])
  @@index([sourceType, sourceId])
  @@index([targetType, targetId])
}
